<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MARKET · NSE"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:singleLine="true" />
        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF94A3B8"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_btn"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FF7DD3FC"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/m_n"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            
            android:background="@drawable/w_row_n"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NIFTY 50"
                    android:textColor="#FF94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/m_n_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/m_n_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFE6EAF2"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="22sp" />
            <TextView
                android:id="@+id/m_n_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="waiting for price"
                android:textColor="#FF94A3B8"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/m_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_row_n"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BANK NIFTY"
                    android:textColor="#FF94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/m_b_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/m_b_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFE6EAF2"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="22sp" />
            <TextView
                android:id="@+id/m_b_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="waiting for price"
                android:textColor="#FF94A3B8"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
