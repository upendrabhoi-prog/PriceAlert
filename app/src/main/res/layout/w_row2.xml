<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="5dp">
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/w_row_n"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/r2_sym"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFE6EAF2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/r2_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/w_tag"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="#FF0A0F1C"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:id="@+id/r2_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:textColor="#FFC9D1E0"
                    android:textSize="10.5sp"
                    android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/r2_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/r2_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF94A3B8"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp">
            <ProgressBar
                android:id="@+id/r2_pb_r"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/w_pb_r"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/r2_pb_y"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/w_pb_y"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/r2_pb_b"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/w_pb_b"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/r2_pb_g"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/w_pb_g"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
