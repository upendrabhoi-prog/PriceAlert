<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WEALTHORA · PORTFOLIO"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:singleLine="true" />
        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF94A3B8"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_btn"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FF7DD3FC"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹—"
        android:textColor="#FFE6EAF2"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true" />
    <TextView
        android:id="@+id/w_pl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Wealthora to load prices"
        android:textColor="#FF94A3B8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invested"
                android:textColor="#FF94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_inv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFE6EAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's P&amp;L"
                android:textColor="#FF94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFE6EAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/w_tag"
        android:padding="6dp"
        android:textColor="#FFE6EAF2"
        android:textSize="11.5sp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#FF94A3B8"
        android:textSize="11sp"
        android:singleLine="true" />
</LinearLayout>
